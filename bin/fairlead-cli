#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$ROOT_DIR/lib"
SRC_GOSU="$ROOT_DIR/src/main/gosu"
BENCH_GOSU="$ROOT_DIR/benchmarks/gosu"
CLASSES="$ROOT_DIR/build/classes/java"

exec java -cp "$CLASSES:$LIB_DIR/*" gw.lang.Gosu -classpath "$SRC_GOSU:$BENCH_GOSU:$CLASSES" -e "fairlead.Main.main(new String[]{\"demo\"})"
