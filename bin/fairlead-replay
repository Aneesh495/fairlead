#!/usr/bin/env bash
set -e

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$ROOT_DIR/lib"
SRC_GOSU="$ROOT_DIR/src/main/gosu"
CLASSES="$ROOT_DIR/build/classes/java"

SYMBOL="${1:-AAPL}"
PRICE="${2:-180.00}"

exec java -cp "$CLASSES:$LIB_DIR/*" gw.lang.Gosu -classpath "$SRC_GOSU:$CLASSES" -e "
uses fairlead.marketdata.MarketDataFeedHandler
uses fairlead.marketdata.MarketDataReplayEngine
var h = new MarketDataFeedHandler()
var r = new MarketDataReplayEngine(h, 42L)
r.generateLiquidMarket('$SYMBOL', Double.parseDouble('$PRICE'))
print('Replayed market data for $SYMBOL:')
print(h.getNBBO('$SYMBOL'))
"
